# Stripe API keys — find these in Stripe Dashboard > Developers > API keys
# Use the TEST keys (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret
# Auto-filled by `npm run setup` — you don't need to paste this in by hand.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Your app's public URL (used to build redirect links after checkout)
APP_URL=https://www.ridem8.kiwi

PORT=4000

# Session signing secret — auto-generated and appended here the first time
# the server runs if it's missing. No action needed.
# JWT_SECRET=
